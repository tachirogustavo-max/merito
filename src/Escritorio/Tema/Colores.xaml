<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="NombreProducto">Mérito</sys:String>
    <sys:String x:Key="Descriptor">Registro académico</sys:String>

    <FontFamily x:Key="FuenteTexto">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FuenteTitulo">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FuenteCodigo">Cascadia Mono, Consolas</FontFamily>

    <!-- Índigo de marca -->
    <Color x:Key="ColorIndigo950">#0F1033</Color>
    <Color x:Key="ColorIndigo900">#17184A</Color>
    <Color x:Key="ColorIndigo800">#25267A</Color>
    <Color x:Key="ColorIndigo700">#3434A8</Color>
    <Color x:Key="ColorIndigo600">#4343D0</Color>
    <Color x:Key="ColorIndigo500">#5D5FEA</Color>
    <Color x:Key="ColorIndigo400">#8486F2</Color>
    <Color x:Key="ColorIndigo300">#ABADF7</Color>
    <Color x:Key="ColorIndigo100">#E4E5FD</Color>
    <Color x:Key="ColorIndigo50">#F2F2FE</Color>

    <Color x:Key="ColorAmbar">#F5A524</Color>
    <Color x:Key="ColorFondo">#F5F6FA</Color>
    <Color x:Key="ColorSuperficie">#FFFFFF</Color>
    <Color x:Key="ColorSombra">#1B1E3A</Color>

    <SolidColorBrush x:Key="Indigo950" Color="{StaticResource ColorIndigo950}"/>
    <SolidColorBrush x:Key="Indigo900" Color="{StaticResource ColorIndigo900}"/>
    <SolidColorBrush x:Key="Indigo800" Color="{StaticResource ColorIndigo800}"/>
    <SolidColorBrush x:Key="Indigo700" Color="{StaticResource ColorIndigo700}"/>
    <SolidColorBrush x:Key="Indigo600" Color="{StaticResource ColorIndigo600}"/>
    <SolidColorBrush x:Key="Indigo500" Color="{StaticResource ColorIndigo500}"/>
    <SolidColorBrush x:Key="Indigo400" Color="{StaticResource ColorIndigo400}"/>
    <SolidColorBrush x:Key="Indigo300" Color="{StaticResource ColorIndigo300}"/>
    <SolidColorBrush x:Key="Indigo100" Color="{StaticResource ColorIndigo100}"/>
    <SolidColorBrush x:Key="Indigo50" Color="{StaticResource ColorIndigo50}"/>
    <SolidColorBrush x:Key="Ambar" Color="{StaticResource ColorAmbar}"/>

    <!-- Neutros -->
    <SolidColorBrush x:Key="Fondo" Color="{StaticResource ColorFondo}"/>
    <SolidColorBrush x:Key="Superficie" Color="{StaticResource ColorSuperficie}"/>
    <SolidColorBrush x:Key="SuperficieTenue" Color="#F9FAFC"/>
    <SolidColorBrush x:Key="Neutro100" Color="#EEF0F6"/>
    <SolidColorBrush x:Key="Borde" Color="#E2E5EE"/>
    <SolidColorBrush x:Key="BordeFuerte" Color="#CDD2DF"/>
    <SolidColorBrush x:Key="BordeHover" Color="#AEB4C6"/>
    <SolidColorBrush x:Key="Texto" Color="#171A2C"/>
    <SolidColorBrush x:Key="Texto2" Color="#4E5470"/>
    <SolidColorBrush x:Key="Texto3" Color="#7D839C"/>
    <SolidColorBrush x:Key="FilaHover" Color="#F6F7FC"/>
    <SolidColorBrush x:Key="CabeceraTabla" Color="#F7F8FB"/>

    <!-- Estados -->
    <SolidColorBrush x:Key="Exito" Color="#13795B"/>
    <SolidColorBrush x:Key="ExitoSuave" Color="#E3F4EC"/>
    <SolidColorBrush x:Key="Aviso" Color="#9A5B00"/>
    <SolidColorBrush x:Key="AvisoSuave" Color="#FFF3DC"/>
    <SolidColorBrush x:Key="Error" Color="#BE3144"/>
    <SolidColorBrush x:Key="ErrorSuave" Color="#FCE9EC"/>
    <SolidColorBrush x:Key="ErrorBorde" Color="#F3C3CB"/>
    <SolidColorBrush x:Key="NeutroSuave" Color="#EEF0F6"/>

    <!-- Barra lateral -->
    <LinearGradientBrush x:Key="FondoLateral" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#17184A" Offset="0"/>
        <GradientStop Color="#101036" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TextoSobreMarca" Color="White"/>
    <SolidColorBrush x:Key="LateralTexto" Color="#B9BBEA"/>
    <SolidColorBrush x:Key="LateralTenue" Color="#8184C4"/>
    <SolidColorBrush x:Key="LateralHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="LateralActivo" Color="#22FFFFFF"/>

    <LinearGradientBrush x:Key="DegradadoMarca" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2B2C8C" Offset="0"/>
        <GradientStop Color="#17184A" Offset="0.55"/>
        <GradientStop Color="#0F1033" Offset="1"/>
    </LinearGradientBrush>

    <!-- Compatibilidad con nombres anteriores -->
    <SolidColorBrush x:Key="Tinta" Color="#171A2C"/>
    <SolidColorBrush x:Key="Papel" Color="{StaticResource ColorFondo}"/>
    <SolidColorBrush x:Key="Acento" Color="{StaticResource ColorIndigo600}"/>
    <SolidColorBrush x:Key="Linea" Color="#E2E5EE"/>

    <!-- Logotipo -->
    <DrawingImage x:Key="Logo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#4343D0" Geometry="M10,0 H30 A10,10 0 0 1 40,10 V30 A10,10 0 0 1 30,40 H10 A10,10 0 0 1 0,30 V10 A10,10 0 0 1 10,0 Z"/>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M8,13 L18.5,19.5 V25.8 L13.5,22.7 V32 L8,28.8 Z"/>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M21.5,19.5 L32,13 V28.8 L26.5,32 V22.7 L21.5,25.8 Z"/>
                <GeometryDrawing Brush="#F5A524" Geometry="M16,11 L20,5.5 H26 L22,11 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage></ResourceDictionary>
