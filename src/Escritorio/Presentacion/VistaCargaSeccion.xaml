<p:VistaBase x:Class="Escritorio.Presentacion.VistaCargaSeccion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:p="clr-namespace:Escritorio.Presentacion"
             mc:Ignorable="d" d:Language="es-VE" d:DesignWidth="760" d:DesignHeight="660">
    <p:VistaBase.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
    </p:VistaBase.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Asignar por sección" Style="{StaticResource TituloDialogo}" FontSize="21"/>
            <TextBlock Style="{StaticResource TextoSecundario}" TextWrapping="Wrap" Margin="0,6,0,18"
                       Text="Elige la sección y pon el docente de cada materia. Las que dejes vacías no se asignan; las que ya tienen docente quedan como están."/>
            <!-- Período y, para encontrar rápido la sección, carrera y semestre -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Label Content="_Período" Target="{Binding Caja, ElementName=ListaPeriodo}"/>
                    <p:ListaBuscable x:Name="ListaPeriodo" DisplayMemberPath="Nombre" AutomationProperties.Name="Período"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="_Carrera" Target="{Binding Caja, ElementName=ListaCarrera}"/>
                    <p:ListaBuscable x:Name="ListaCarrera" DisplayMemberPath="Nombre" Ayuda="Todas" AutomationProperties.Name="Carrera"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Label Content="Se_mestre" Target="{Binding Caja, ElementName=ListaSemestre}"/>
                    <p:ListaBuscable x:Name="ListaSemestre" DisplayMemberPath="Nombre" Ayuda="Todos" AutomationProperties.Name="Semestre"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <Label Content="_Sección" Target="{Binding Caja, ElementName=ListaSeccion}"/>
                    <p:ListaBuscable x:Name="ListaSeccion" DisplayMemberPath="Nombre" AutomationProperties.Name="Sección"/>
                </StackPanel>
            </Grid>
            <CheckBox x:Name="TodoElPensum" Content="Ver todo el pensum de la carrera, no solo el semestre de la sección" Margin="0,0,0,14" Visibility="Collapsed" d:Visibility="Visible"/>
            <Grid Margin="14,0,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Materia" Style="{StaticResource Rotulo}"/>
                <TextBlock Grid.Column="1" Text="Docente" Style="{StaticResource Rotulo}"/>
            </Grid>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar" Style="{StaticResource BotonSecundario}" MinWidth="104" Margin="0,0,10,0" Click="Cancelar_Click"/>
                <p:BotonAccion Texto="Guardar" Icono="IcoGuardar" Atajo="Ctrl+G" Margin="0" Click="Guardar_Click"/>
            </StackPanel>
            <TextBlock x:Name="Resumen" VerticalAlignment="Center" Foreground="{DynamicResource Texto2}" d:Text="5 materias, 1 ya asignada, 2 por guardar"/>
        </DockPanel>
        <p:FranjaAviso DockPanel.Dock="Bottom"/>

        <Border BorderThickness="1" CornerRadius="10" ClipToBounds="True" BorderBrush="{DynamicResource Borde}" Background="{DynamicResource Superficie}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock x:Name="Vacio" Style="{StaticResource TextoSecundario}" Margin="18,22" TextWrapping="Wrap"
                               Text="Elige una sección para ver sus materias." d:Visibility="Collapsed"/>
                    <ItemsControl x:Name="Filas" Focusable="False" d:ItemsSource="{x:Static p:Muestras.FilasCarga}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,8,10,8" BorderThickness="0,0,0,1" MinHeight="54" BorderBrush="{DynamicResource Borde}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="320"/>
                                        </Grid.ColumnDefinitions>
                                        <WrapPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Materia.Codigo}" Width="96" Foreground="{DynamicResource Texto3}" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Materia.Nombre}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Nota}" FontSize="11.5" Margin="10,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Texto3}"
                                                       Visibility="{Binding TieneNota, Converter={StaticResource Visible}}"/>
                                        </WrapPanel>
                                        <!-- Ya asignada: se muestra su docente -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0"
                                                    ToolTip="Ya asignada. Para cambiarla usa «Cambiar docente»."
                                                    Visibility="{Binding Asignada, Converter={StaticResource Visible}}">
                                            <p:Icono Datos="{StaticResource IcoCheck}" Width="15" Height="15" TextElement.Foreground="{DynamicResource Exito}"/>
                                            <TextBlock Text="{Binding AsignadaA}" Margin="8,0,0,0" Foreground="{DynamicResource Texto2}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <!-- Libre: se elige el docente -->
                                        <p:ListaBuscable Grid.Column="1" DisplayMemberPath="ConCedula" Ayuda="Sin asignar"
                                                         ItemsSource="{Binding Docentes, RelativeSource={RelativeSource AncestorType=p:VistaCargaSeccion}}"
                                                         SelectedItem="{Binding Docente, Mode=TwoWay}"
                                                         AutomationProperties.Name="{Binding Materia.Nombre, StringFormat='Docente de {0}'}"
                                                         Visibility="{Binding Libre, Converter={StaticResource Visible}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</p:VistaBase>
