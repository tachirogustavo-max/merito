<p:VentanaBase x:Class="Escritorio.Presentacion.VentanaImportacion"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:p="clr-namespace:Escritorio.Presentacion"
               mc:Ignorable="d" d:Language="es-VE"
               Title="Revisar matrícula" Width="940" Height="620" MinWidth="700" MinHeight="420"
               WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="30,4,30,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock x:Name="Cantidad" Style="{StaticResource TituloDialogo}" FontSize="21" d:Text="32 estudiantes"/>
            <TextBlock x:Name="Detalle" Style="{StaticResource TextoSecundario}" Margin="0,6,0,0" TextWrapping="Wrap"
                       d:Text="Lógica de programación, sección A, 2-2026. Verifica la matrícula institucional antes de confirmar."/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" IsCancel="True" Style="{StaticResource BotonSecundario}" MinWidth="104" Margin="0,0,10,0"/>
            <Button x:Name="Aceptar" Content="Confirmar importación" IsDefault="True" MinWidth="150" Click="Confirmar_Click"/>
        </StackPanel>
        <p:Rejilla x:Name="Filas" Columnas="Cédula=Cedula; Nombres=Nombres; Apellidos=Apellidos; Carrera=Carrera; Sección=Seccion; Correo=Correo"/>
    </DockPanel>
</p:VentanaBase>
